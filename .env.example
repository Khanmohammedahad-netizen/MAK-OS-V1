# ─────────────────────────────────────────────────
# MAK Lead Engine — Environment Variables
# Copy to .env and fill in values before running.
# ─────────────────────────────────────────────────

# ── Supabase (Free tier — https://supabase.com/dashboard) ──
SUPABASE_URL=https://your-project.supabase.co          # Project Settings → API → URL
SUPABASE_SERVICE_ROLE_KEY=eyJ...                        # Project Settings → API → service_role (secret!)
SUPABASE_ANON_KEY=eyJ...                                # Project Settings → API → anon (public, for dashboard)

# ── Google Gemini (Free tier — https://aistudio.google.com/apikey) ──
# 15 RPM, 1M tokens/day, Gemini 1.5 Flash only.
GEMINI_API_KEY=AIza...

# ── Brevo Transactional Email (Free — 300/day — https://app.brevo.com) ──
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=ahad@maksoftware.co
BREVO_SENDER_NAME=Ahad Khan

# ── Google Maps / Places API (Free $200/mo credit — https://console.cloud.google.com/apis) ──
# Only used as secondary enrichment for leads missing website/phone.
GOOGLE_MAPS_API_KEY=AIza...

# ── Yelp Fusion (Free 500 calls/day — https://www.yelp.com/developers) ──
YELP_API_KEY=Bearer ...

# ── Companies House (Free, 600 req/5min — https://developer.company-information.service.gov.uk) ──
# UK leads only. Register an application to get a key.
COMPANIES_HOUSE_API_KEY=...

# ── Apify (OPTIONAL — disabled by default) ──
APIFY_ENABLED=false
APIFY_TOKEN=apify_api_...

# ── Pipeline Behaviour ──
LEAD_SCRAPE_CAP=50                # Max leads scraped per run
EMAIL_DAILY_CAP=30                # Max emails sent per run (Brevo free = 300/day)
AUTO_APPROVE=true                 # Auto-approve drafts that pass score threshold
DRY_RUN=false                     # true = skip sending emails
SCORE_THRESHOLD=40                # Minimum score to queue a lead for outreach

# ── Target Configuration ──
TARGET_NICHE=restaurant            # restaurant | salon | clinic | trades | generic
TARGET_COUNTRY=GB                  # ISO 3166-1 alpha-2
TARGET_CITY=London
# Overpass bounding box: south,west,north,east
TARGET_BBOX=51.28,-0.49,51.69,0.24

# ── GCP (set by Cloud Run automatically, or override locally) ──
GCP_PROJECT_ID=mak-lead-engine
GCP_REGION=asia-south1

# ── Logging ──
LOG_LEVEL=INFO
LOG_FORMAT=json                    # json | console
